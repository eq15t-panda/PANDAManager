   "execution_count": 123,
   "source": [
    "aqm = AcquisitionAnalysisManager(os.path.join(path_folder_data, name_exp))\n",
    "\n",
    "P_in = []\n",
    "P_in_error = []\n",
    "P_tr = []\n",
    "P_tr_error = []\n",
    "\n",
    "for f_front, f_back in zip(folder_data_files[0::2], folder_data_files[1::2]):\n",
    "\n",
    "    aqm.analysis_cell(filename=os.path.join(path_folder_data, name_exp, f_front))\n",
    "    P_front = aqm.data[\"mean_mW\"]\n",
    "    P_front_error = aqm.data[\"error_mW\"]\n",
    "\n",
    "    aqm.analysis_cell(filename=os.path.join(path_folder_data, name_exp, f_back))\n",
    "    P_back = aqm.data[\"mean_mW\"]\n",
    "    P_back_error = aqm.data[\"error_mW\"]\n",
    "\n",
    "    P_in.append(P_front)\n",
    "    P_in_error.append(P_front_error)\n",
    "    P_tr.append(P_back)\n",
    "    P_tr_error.append(P_back_error)"
   ],
   "id": "e4e79cf6647c7681"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": 124,
   "source": [
    "# Incident power\n",
    "P_in = np.array(P_in)\n",
    "P_in_error = np.array(P_in_error)\n",
    "\n",
    "# Transmitted power (or reflected power depending on what measurement is done)\n",
    "P_tr = np.array(P_tr)\n",
    "P_tr_error = np.array(P_tr_error)"
   ],
   "id": "c93e87eb23a3a4a8"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Power in (mW):  [10.21455502 21.44447687 30.81165859 39.91861249 50.23413524 60.57434662] Error:  [0.0225478  0.02979106 0.13437767 0.02182648 0.04142513 0.0223165 ]\n",
      "Power transmitted/reflected (mW):  [ 9.86998547 20.8509909  29.51874594 39.29015417 48.60591125 60.68337093] Error:  [0.0486445  0.05852048 0.03071164 0.03847029 0.03672048 0.02837524]\n"
     ]
    }
   ],
   "execution_count": 125,
   "source": [
    "# Check arrays\n",
    "print(\"Power in (mW): \", P_in, \"Error: \", P_in_error)\n",
    "print(\"Power transmitted/reflected (mW): \", P_tr, \"Error: \", P_tr_error)"
   ],
   "id": "8fe38679f737ead3"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": 126,
   "source": [
    "# Fit for transmitted power\n",
    "popt, pcov = curve_fit(linear, P_in, P_tr)\n",
    "T, offset = popt\n",
    "T_err, offset_err = np.sqrt(np.diag(pcov))\n",
    "\n",
    "R = 1 - T\n",
    "R_err = T_err\n",
    "\n",
    "xfit = np.linspace(0, 1.05*np.max(P_in), 300)"
   ],
   "id": "c89a5d9c66df3179"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [],
   "execution_count": 127,
   "source": "# Fit for reflected power",
   "id": "a2ebcc93ee6ef6af"
  },
  {
   "metadata": {},
   "cell_type": "code",
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 900x720 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Transmission coefficient T = 0.999551 ± 0.017049\n",
      "Reflectivity coefficient R = 1 - T = 0.000449 ± 0.017049\n",
      "Fit offset = -0.714 ± 0.671 mW\n"
     ]
    }
   ],
   "execution_count": 128,
   "source": [
    "# Plotting\n",
    "plt.figure(figsize=(5, 4))\n",
    "\n",
    "plt.plot(xfit, linear(xfit, *popt),\n",
    "    \"--\",\n",
    "    color=\"#C0392B\",\n",
    "    # color=\"#2E86AB\",\n",
    "    linewidth=1.5,\n",
    "    # label=rf\"$R={T:.4f}\\pm{T_err:.4f}$\") # Switch commented line depending on what is plotted\n",
    "    label=rf\"$T={T:.4f}\\pm{T_err:.4f}$\")\n",
    "\n",
    "plt.plot(P_in, P_tr,\n",
    "    \"o\",\n",
    "    color=\"black\",\n",
    "    markersize=4,\n",
    "    markerfacecolor=\"white\",\n",
    "    markeredgewidth=1.2,\n",
    "    label=\"data\")\n",
    "\n",
    "plt.xlabel(\"Input power (mW)\")\n",
    "plt.ylabel(\"Transmitted power (mW)\") # Switch commented line depending on what is plotted\n",
    "# plt.ylabel(\"Reflected Power (mW)\")\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.savefig(f\"./plot/figure/{name_exp}_002.svg\", dpi=300)\n",
    "plt.show()\n",
    "\n",
    "print(f\"Transmission coefficient T = {T:.6f} ± {T_err:.6f}\")\n",
    "print(f\"Reflectivity coefficient R = 1 - T = {R:.6f} ± {R_err:.6f}\")\n",
    "print(f\"Fit offset = {offset:.3f} ± {offset_err:.3f} mW\")"
   ],
